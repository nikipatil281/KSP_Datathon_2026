{
  "functions": {
    "targets": [
      "crime-api-fn",
      "fir-ocr-api-fn"
    ],
    "ignore": [
      "node_modules",
      "._*"
    ],
    "source": "functions"
  },
  "client": {
    "source": "client/dist",
    "ignore": [
      "._*"
    ],
    "scripts": {
      "build": "npm install --prefix client && npm run build --prefix client",
      "predeploy": "catalyst run client:build"
    }
  }
}
